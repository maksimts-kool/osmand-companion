<?xml version="1.0" encoding="utf-8"?>
<!-- A departure to choose for a ride: its line and where it goes, and when; one that can't be made in time is dimmed
     with a timer. The chosen one is highlighted (in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    android:background="@drawable/pl_option_bg"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="12dp">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="40dp"
        android:minHeight="40dp" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/tt_badge_bg"
        android:drawablePadding="3dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:minWidth="36dp"
        android:paddingStart="5dp"
        android:paddingEnd="7dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        tools:backgroundTint="#00897B"
        tools:text="33" />

    <TextView
        android:id="@+id/headsign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="Männiku" />

    <ImageView
        android:id="@+id/timer"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/pl_cant_make"
        android:src="@drawable/tt_ic_timer"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:visibility="visible" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="3dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/tt_anim_live"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textStyle="bold"
        tools:text="20 min" />
</LinearLayout>
