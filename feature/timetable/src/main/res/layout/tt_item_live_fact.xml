<?xml version="1.0" encoding="utf-8"?>
<!-- Leads a trip's header facts when the vehicle gives its times: the animated live mark and "live", in green, so
     the stops below needn't each say so. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/tt_pill_bg"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingVertical="6dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/tt_anim_live" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textStyle="bold" />
</LinearLayout>
