<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions, the background service and OsmAnd package visibility come from :core. -->

    <!-- Updates from GitHub Releases (Updater); the user allows it once, on the first update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup off: the prefs may hold the Telegram bot token from the trip summaries feature. -->
    <application
        android:name=".CompanionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Companion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Companion.OsmAnd"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OsmAnd's main menu item "Transit timetables" (OsmAndStopUi.DEEP_LINK). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="timetable"
                    android:scheme="osmandcompanion" />
            </intent-filter>
        </activity>

        <!-- Result of an update's install session. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
