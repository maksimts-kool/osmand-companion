<resources>
    <!-- The Next departures sheet: a see-through window over OsmAnd. The sheet slides itself in, so no window animation. -->
    <style name="Theme.TtSheet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/tt_osm_accent</item>
        <item name="colorOnSurface">@color/tt_osm_text</item>
    </style>

    <!-- OsmAnd's outlined context menu buttons: grey outline, accent text and icon, capitals. -->
    <style name="TtSheetButton" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/tt_osm_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="iconTint">@color/tt_osm_accent</item>
        <item name="iconSize">20dp</item>
        <item name="strokeColor">@color/tt_osm_button_outline</item>
        <item name="cornerRadius">4dp</item>
        <item name="rippleColor">@color/tt_osm_divider</item>
    </style>
</resources>
