<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        "Display over other apps": the only way Android (10+) lets us open the Next departures sheet, or a stop here,
        while OsmAnd is in front. Without it, a notification opens them instead.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <!--
            Exported: OsmAnd's Next departure widget opens it. Opened from OsmAnd (StopActivity.intent's fromOsmand),
            it's in a task of its own, so closing it goes back to OsmAnd, not to this app's home screen; opened from
            this app, it's in the app's task as usual.
        -->
        <activity
            android:name=".StopActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.stop" />

        <activity
            android:name=".TripActivity"
            android:exported="false" />

        <!-- Next departures, over OsmAnd's map. Its own task, so closing it goes back to OsmAnd, not to this app. -->
        <activity
            android:name=".DaySheetActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="${applicationId}.sheet"
            android:theme="@style/Theme.TtSheet" />

        <!-- OsmAnd reads the stop icons for its map from here; see StopIconProvider. -->
        <provider
            android:name=".StopIconProvider"
            android:authorities="${applicationId}.stopicons"
            android:exported="true" />
    </application>
</manifest>
