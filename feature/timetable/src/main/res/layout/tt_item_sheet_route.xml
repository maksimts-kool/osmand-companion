<?xml version="1.0" encoding="utf-8"?>
<!-- One route and direction in the Full day sheet: its number, where it goes, and its times left today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tt_badge_bg"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingHorizontal="6dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="5" />

        <TextView
            android:id="@+id/headsign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tt_osm_text"
            android:textSize="16sp"
            tools:text="→ Metsakooli" />

        <!-- How soon the next one leaves; hidden when that's more than two hours away. -->
        <TextView
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/tt_osm_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="in 6 min" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />
</LinearLayout>
