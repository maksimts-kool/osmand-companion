<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".PlaceSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!--
            Opened from the trip's notification or OsmAnd's widget (with NEW_TASK), it's in a task of its own, so Back
            goes back to where that was; opened from this app, it's in the app's task as usual.
        -->
        <activity
            android:name=".ItineraryActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.trip" />

        <!-- The trip notification's New way and Stop buttons. -->
        <receiver
            android:name=".TripActionReceiver"
            android:exported="false" />
    </application>
</manifest>
